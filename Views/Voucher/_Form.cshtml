@model SaigonBite.OFDH.Domain.Voucher

<div class="mb-3">
    <label asp-for="Code" class="form-label"></label>
    <input asp-for="Code" class="form-control" />
    <span asp-validation-for="Code" class="text-danger"></span>
</div>
<div class="mb-3">
    <label asp-for="Type" class="form-label"></label>
    <select asp-for="Type" asp-items="Html.GetEnumSelectList<SaigonBite.OFDH.Domain.VoucherType>()" class="form-select"></select>
</div>
<div class="mb-3">
    <label asp-for="Value" class="form-label"></label>
    <input asp-for="Value" class="form-control" />
    <div class="form-text">VND amount for Fixed, 1-100 for Percentage.</div>
    <span asp-validation-for="Value" class="text-danger"></span>
</div>
<div class="mb-3">
    <label asp-for="MaxDiscount" class="form-label"></label>
    <input asp-for="MaxDiscount" class="form-control" />
    <div class="form-text">Optional cap, used only for Percentage.</div>
</div>
<div class="mb-3">
    <label asp-for="MinOrderValue" class="form-label"></label>
    <input asp-for="MinOrderValue" class="form-control" />
</div>
<div class="mb-3">
    <label asp-for="ValidFrom" class="form-label"></label>
    <input asp-for="ValidFrom" type="date" class="form-control" />
</div>
<div class="mb-3">
    <label asp-for="ValidTo" class="form-label"></label>
    <input asp-for="ValidTo" type="date" class="form-control" />
</div>
<div class="mb-3">
    <label asp-for="UsageLimit" class="form-label"></label>
    <input asp-for="UsageLimit" class="form-control" />
    <span asp-validation-for="UsageLimit" class="text-danger"></span>
</div>