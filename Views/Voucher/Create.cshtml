@model SaigonBite.OFDH.Domain.Voucher
@{
    ViewData["Title"] = "Create voucher";
}

<h2>Create voucher</h2>
<p class="text-muted">A new voucher starts as <strong>Draft</strong>. Activate it from the list when it is ready.</p>

<form asp-action="Create" method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <partial name="_Form" model="Model" />
    <button type="submit" class="btn btn-primary">Save</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>