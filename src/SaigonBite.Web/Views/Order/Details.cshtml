@model Order
@{
    ViewData["Title"] = "Order #" + Model.Id;
    var payment = (Payment?)ViewBag.Payment;
    var steps = new[] { OrderStatus.Placed, OrderStatus.Confirmed, OrderStatus.Preparing, OrderStatus.ReadyForPickup, OrderStatus.OutForDelivery, OrderStatus.Delivered };
    int reached = Array.IndexOf(steps, Model.Status);
    var price = new PriceQuote
    {
        FoodSubtotal = Model.FoodSubtotal, DistanceKm = Model.DistanceKm, BilledKm = (int)Math.Ceiling(Model.DistanceKm - 1e-9),
        DeliveryFee = Model.DeliveryFee, QuietDiscount = Model.QuietDiscount, VoucherCode = Model.VoucherCode,
        VoucherDiscount = Model.VoucherDiscount, Surcharge = Model.Surcharge,
    };
}
<h1>Order #@Model.Id <span class="badge @StatusClass(Model.Status) fs-6 align-middle">@Model.Status</span></h1>
<p class="text-muted">Receipt and tracking. <span class="uc-tag">UC03 post-condition · UC04 Track an order</span></p>
<div class="d-flex gap-2 flex-wrap mb-4">
    @for (int i = 0; i < steps.Length; i++)
    {
        <span class="badge @(reached >= i ? "text-bg-primary" : "text-bg-light border")">@steps[i]</span>
    }
</div>
@if (Model.Note != null)
{
    <div class="alert alert-secondary">@Model.Note</div>
}
<div class="row g-4">
    <div class="col-lg-6">
        <div class="card p-3">
            <h2 class="h5">@Model.HubName</h2>
            <table class="table table-sm">
                @foreach (var l in Model.Lines)
                {
                    <tr><td>@l.Quantity × @l.ItemName</td><td class="text-end">@Vnd(l.LineTotal)</td></tr>
                }
            </table>
            <div><b>Deliver to:</b> @Model.DeliveryStreet, @Model.DeliveryDistrict</div>
            <div><b>Placed:</b> @Model.PlacedAt.ToString("dd/MM/yyyy HH:mm")</div>
            <div><b>Payment:</b> @Model.PaymentMethod · @payment?.Status @(payment?.GatewayRef is string r ? "(" + r + ")" : "")</div>
            @if (Model.CanCancel)
            {
                <form method="post" asp-action="Cancel" asp-route-id="@Model.Id" class="mt-3">
                    <button class="btn btn-outline-danger btn-sm">Cancel order (only before the kitchen confirms)</button>
                </form>
            }
        </div>
    </div>
    <div class="col-lg-6">
        <div class="card p-3">
            <partial name="_Price" model="price" />
        </div>
    </div>
</div>
