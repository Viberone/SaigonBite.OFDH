@model OrderPageVM
@{ ViewData["Title"] = "Confirm your order"; }
<h1>Confirm your order</h1>
<p class="text-muted">Step 2 of 3 · check the full price, then confirm. <span class="uc-tag">UC03 Place an Order · 523C0007</span></p>
@if (Model.Errors.Count > 0)
{
    <div class="alert alert-danger"><ul class="mb-0">@foreach (var e in Model.Errors) { <li>@e</li> }</ul></div>
}
<div class="row g-4">
    <div class="col-lg-6">
        <div class="card p-3">
            <h2 class="h5">@Model.Hub.Name</h2>
            <table class="table table-sm">
                @foreach (var l in Model.Lines)
                {
                    <tr><td>@l.Quantity × @l.ItemName</td><td class="text-end">@Vnd(l.LineTotal)</td></tr>
                }
            </table>
            <div><b>Deliver to:</b> @Model.Address</div>
            <div><b>Payment:</b> @Model.Form.PaymentMethod</div>
        </div>
    </div>
    <div class="col-lg-6">
        <div class="card p-3">
            <partial name="_Price" model="Model.Quote" />
            <form method="post" asp-action="Place" class="mt-3">
                <input type="hidden" name="HubId" value="@Model.Form.HubId" />
                <input type="hidden" name="AddressId" value="@Model.Form.AddressId" />
                <input type="hidden" name="VoucherCode" value="@Model.Form.VoucherCode" />
                <input type="hidden" name="PaymentMethod" value="@Model.Form.PaymentMethod" />
                @foreach (var l in Model.Lines)
                {
                    <input type="hidden" name="Quantities[@l.ItemId]" value="@l.Quantity" />
                }
                <button class="btn btn-accent w-100">Confirm order · @Vnd(Model.Quote!.Total)</button>
            </form>
            <a class="btn btn-link w-100 mt-2" asp-action="New" asp-route-hubId="@Model.Hub.Id">Change the order</a>
        </div>
    </div>
</div>
